# JFROG JFMELT POD LOGS
# Fluentd sidecar config for the standalone `jfmelt` Deployment.
# Requires Artifactory 7.161+ (helm chart 107.161+), where jfmelt runs as its own
# Deployment with containers [observability, jfmelt, router] sharing the `data` emptyDir.
# Platform metrics and callhome are collected by the artifactory pod's sidecar via fluent.conf.rt.

# LOG SOURCE DIRECTIVES
## SERVICE LOGS
<source>
  @type tail
  @id jfmelt_service_tail
  path "#{ENV['JF_PRODUCT_DATA_INTERNAL']}/log/jfmelt-service.log"
  pos_file "#{ENV['JF_PRODUCT_DATA_INTERNAL']}/log/jfmelt-service.log.pos"
  tag jfrog.rt.jfmelt.service
  <parse>
    @type none
  </parse>
</source>
<source>
  @type tail
  @id router_service_tail
  path "#{ENV['JF_PRODUCT_DATA_INTERNAL']}/log/router-service.log"
  pos_file "#{ENV['JF_PRODUCT_DATA_INTERNAL']}/log/router-service.log.pos"
  tag jfrog.rt.router.service
  <parse>
    @type none
  </parse>
</source>
## TRAEFIK LOGS
<source>
  @type tail
  @id router_traefik_tail
  path "#{ENV['JF_PRODUCT_DATA_INTERNAL']}/log/router-traefik.log"
  pos_file "#{ENV['JF_PRODUCT_DATA_INTERNAL']}/log/router-traefik.log.pos"
  tag jfrog.rt.router.traefik
  <parse>
      @type multiline
      format_firstline /\d{4}-\d{1,2}-\d{1,2}/
      format1 /^(?<log_timestamp>[^ ]*) \[(?<service_type>[^\]]*)\] \[(?<log_level>[^\]]*)\] \[(?<trace_id>[^\]]*)\] \[(?<class_line_number>.*)\] \[(?<thread>.*)\] \[\] -(?<message>.*)$/
  </parse>
</source>
## REQUEST LOGS
<source>
  @type tail
  @id jfmelt_request_tail
  path "#{ENV['JF_PRODUCT_DATA_INTERNAL']}/log/jfmelt-request.log"
  pos_file "#{ENV['JF_PRODUCT_DATA_INTERNAL']}/log/jfmelt-request.log.pos"
  tag jfrog.rt.jfmelt.request
  <parse>
    @type none
  </parse>
</source>
<source>
  @type tail
  @id jfmelt_request_out_tail
  path "#{ENV['JF_PRODUCT_DATA_INTERNAL']}/log/jfmelt-request-out.log"
  pos_file "#{ENV['JF_PRODUCT_DATA_INTERNAL']}/log/jfmelt-request-out.log.pos"
  tag jfrog.rt.jfmelt.request.out
  <parse>
    @type none
  </parse>
</source>
<source>
  @type tail
  @id router_request_tail
  path "#{ENV['JF_PRODUCT_DATA_INTERNAL']}/log/router-request.log"
  pos_file "#{ENV['JF_PRODUCT_DATA_INTERNAL']}/log/router-request.log.pos"
  tag jfrog.rt.router.request
  <parse>
    @type none
  </parse>
</source>


# FILTER DIRECTIVE
## ALL LOGS
<filter **>
  @type concat
  key message
  multiline_start_regexp /\d{4}-\d{1,2}-\d{1,2}/
  timeout_label @NORMAL
  flush_interval 5
</filter>
<match **>
  @type relabel
  @label @NORMAL
</match>
<label @NORMAL>
## SERVICE LOGS
  <filter jfrog.rt.**.service>
    @type record_transformer
    enable_ruby true
    <record>
      message ${record["message"].gsub(/\e\[([;\d]+)?m/, '')}
    </record>
  </filter>
  <filter jfrog.rt.jfmelt.service>
    @type parser
    key_name message
    <parse>
        @type multiline
        format_firstline /\d{4}-\d{1,2}-\d{1,2}/
        format1 /^(?<log_timestamp>[^ ]*) \[(?<service_type>[^\]]*)\] \[(?<log_level>[^\]]*)\] \[(?<trace_id>[^\]]*)\] \[(?<class_line_number>[^\]]*)\] \[(?<thread>[^\]]*)\] \[(?<tenant_id>[^\]]*)\] -(?<message>.*)$/
    </parse>
  </filter>
  <filter jfrog.rt.router.service>
    @type parser
    key_name message
    <parse>
        @type multiline
        format_firstline /\d{4}-\d{1,2}-\d{1,2}/
        format1 /^(?<log_timestamp>[^ ]*) \[(?<service_type>[^\]]*)\] \[(?<log_level>[^\]]*)\] \[(?<trace_id>[^\]]*)\] \[(?<class_line_number>.*)\] \[(?<thread>.*)\] \[\] -(?<message>.*)$/
    </parse>
  </filter>
  ## REQUEST LOGS
  # jfrog.rt.jfmelt.request.out has no parser filter - its field layout is unverified, so it ships as a raw message, like jfrog.rt.router.request.
  # jfrog.rt.router.request has no parser filter, matching fluent.conf.rt - it ships as a raw message.
  # jfrog.rt.jfmelt.request is a new tag with no legacy producer, so numeric fields are typed here.
  # Unlike jfrog.rt.frontend.request, there is no pre-existing fluent.conf.rt parser to stay type-compatible with.
  <filter jfrog.rt.jfmelt.request>
    @type parser
    key_name message
    <parse>
      @type regexp
      expression ^(?<log_timestamp>[^ ]*)\|(?<trace_id>[^\|]*)\|(?<remote_address>[^\|]*)\|(?<username>[^\|]*)\|(?<request_method>[^\|]*)\|(?<request_url>[^\|]*)\|(?<return_status>[^\|]*)\|(?<request_content_length>[^\|]*)\|(?<response_content_length>[^\|]*)\|(?<request_duration>[^\|]*)\|(?<request_user_agent>.+)$
      types response_content_length:integer, request_content_length:integer, return_status:integer
    </parse>
  </filter>
  ## ALL LOGS
  <filter jfrog.**>
    @type record_transformer
    <record>
      hostname "#{Socket.gethostname}"
      log_source ${tag}
    </record>
  </filter>
  # TEST OUTPUT
  #<match **>
  #  @type stdout
  #</match>

  # DATADOG OUTPUT
  ## DATADOG ARTIFACTORY LOGS OUTPUT
  <match jfrog.**>
    @type datadog
    @id jfrog_jfmelt
    api_key "#{ENV['DATADOG_API_KEY']}"
    #optional
    include_tag_key true
    dd_source jfrog_platform
    service jfrog_artifactory
    host "http-intake.logs.#{ENV['DATADOG_API_HOST']}"
    dd_tags "env:#{ENV['LOG_ENV']}"
    <buffer>
      flush_interval 1s
      # frequency of the buffer flush
      flush_thread_count 5
      # The number of threads to flush/write chunks in parallel
      chunk_limit_records 10
      # The max number of events that each chunks can store in it
    </buffer>
  </match>
</label>
